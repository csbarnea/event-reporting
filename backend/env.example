# =========================
# Database (PostgreSQL)
# =========================
DB_USER=incidents_user
DB_PASSWORD=incidents_password
DB_HOST=localhost
DB_PORT=5433
DB_NAME=incidents_db


# =========================
# Firebase Storage (optional)
# =========================
# Path to Firebase Admin SDK credentials (JSON)
FIREBASE_CREDENTIALS=backend/firebase-service-account.json

# Firebase Storage bucket name
FIREBASE_STORAGE_BUCKET=event-reporting-fdc6f.firebasestorage.app


# =========================
# Notifications (default: mock)
# =========================

# Enable real email notifications via SMTP
# 0 = disabled (mock only)
# 1 = enabled (real emails)
NOTIFY_EMAIL_ENABLED=0


# =========================
# SMTP Settings (optional)
# Used only if NOTIFY_EMAIL_ENABLED=1
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=EventReport <your_email@gmail.com>


# =========================
# JWT auth (admins)
# =========================
JWT_SECRET=change_me
JWT_TTL_MIN=60